DATABASE_URL=postgresql://postgres:postgres@localhost:5432/biblioteca

# --- Nuevo: configuración de JWT ---
# Clave secreta usada para FIRMAR los tokens. En un proyecto real debe ser
# larga, aleatoria, y nunca subirse a git. Para la clase basta con esto.
JWT_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
